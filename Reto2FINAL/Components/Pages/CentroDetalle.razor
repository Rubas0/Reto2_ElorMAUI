@page "/detalle/{Codigo}"
@using Reto2FINAL.Models
@using Reto2FINAL.Services
@inject CentrosService CentrosService
@inject WeatherService WeatherService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="container-fluid p-4">
    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (centro == null)
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> Centro no encontrado
        </div>
        <button class="btn btn-secondary" @onclick="Volver">Volver</button>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-12">
                <button class="btn btn-secondary" @onclick="Volver">Volver al listado</button>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h3 class="mb-0">@centro.NOMBRE</h3>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <p class="mb-2"><strong>Codigo:</strong> @centro.CODIGO</p>
                                <p class="mb-2"><strong>Direccion:</strong> @centro.DIRECCION</p>
                                <p class="mb-2"><strong>Localidad:</strong> @centro.LOCALIDAD</p>
                                <p class="mb-2"><strong>CP:</strong> @centro.CodigoPostal</p>
                            </div>
                            <div class="col-12 col-md-6">
                                <p class="mb-2"><strong>Municipio:</strong> @centro.DMUNIC</p>
                                <p class="mb-2"><strong>Territorio:</strong> @centro.DTERRE</p>
                                <p class="mb-2"><strong>Tipo:</strong> @centro.DTITUC</p>
                                <p class="mb-2"><strong>Telefono:</strong> @centro.TELEFONO</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                @if (cargandoClima)
                {
                    <div class="alert alert-info">
                        Cargando informacion meteorologica...
                    </div>
                }
                else if (weatherCurrent != null)
                {
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <h4 class="mb-0">Temperatura Actual</h4>
                        </div>
                        <div class="card-body">
                            <div class="row text-center g-3">
                                <div class="col-12 col-md-4">
                                    <h1 class="display-4 mb-0">@weatherCurrent.TempC.ToString("F1") C</h1>
                                    <p class="text-muted">@weatherCurrent.Condition?.Text</p>
                                </div>
                                <div class="col-6 col-md-4">
                                    <p class="mb-1"><strong>Viento</strong></p>
                                    <p class="mb-0 fs-5">@weatherCurrent.WindKph.ToString("F1") km/h</p>
                                </div>
                                <div class="col-6 col-md-4">
                                    <p class="mb-1"><strong>Humedad</strong></p>
                                    <p class="mb-0 fs-5">@weatherCurrent.Humidity %</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        <strong>Error:</strong> No se pudo cargar la informacion del clima
                    </div>
                }
            </div>
        </div>

        @if (previsiones.Any())
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h4 class="mb-0">Prevision Proximos Dias</h4>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @foreach (var dia in previsiones.Take(7))
                                {
                                    <div class="col-6 col-sm-4 col-lg-3">
                                        <div class="card h-100">
                                            <div class="card-body text-center p-2">
                                                <h6 class="mb-2">
                                                    @(DateTime.TryParse(dia.Date, out var fecha) ? fecha.ToString("dd/MM") : dia.Date)
                                                </h6>
                                                <p class="mb-2">@dia.WeatherDescription</p>
                                                <p class="text-danger mb-1">
                                                    <strong>Max:</strong> @dia.MaxTemp.ToString("F1") C
                                                </p>
                                                <p class="text-primary mb-0">
                                                    <strong>Min:</strong> @dia.MinTemp.ToString("F1") C
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-warning">
                        <h4 class="mb-0">Ubicacion del Centro</h4>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(errorMapa))
                        {
                            <div class="alert alert-danger">
                                <strong>Error:</strong> @errorMapa
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label"><strong>Tipo de mapa:</strong></label>
                            <div class="d-flex flex-wrap gap-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="mapType" id="map1"
                                           checked="@(tipoMapa == "streets-v12")" @onclick='() => CambiarTipoMapa("streets-v12")'>
                                    <label class="form-check-label" for="map1">Calles</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="mapType" id="map2"
                                           checked="@(tipoMapa == "outdoors-v12")" @onclick='() => CambiarTipoMapa("outdoors-v12")'>
                                    <label class="form-check-label" for="map2">Outdoor</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="mapType" id="map3"
                                           checked="@(tipoMapa == "satellite-streets-v12")" @onclick='() => CambiarTipoMapa("satellite-streets-v12")'>
                                    <label class="form-check-label" for="map3">Satelite</label>
                                </div>
                            </div>
                        </div>

                        <div id="map" style="width:100%;height:500px;background-color:#e0e0e0;border:2px solid #ccc;"></div>

                        <div id="info" class="mt-2 text-muted"></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? Codigo { get; set; }

    private Centro? centro;
    private CurrentWeatherApi? weatherCurrent;
    private List<WeatherDay> previsiones = new();
    private bool cargando = true;
    private bool cargandoClima = false;
    private string errorMapa = string.Empty;

    private string token = "pk.eyJ1IjoiaW5mamdvbnphbGV6IiwiYSI6ImNsODcyMXF6cDE0ZDI0MmxoODFqMzR3OGIifQ.VAuTB3faQPTx7P6bRnEZjg";
    private int zoom = 14;
    private string tipoMapa = "streets-v12";
    private bool mapaInicializado = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && centro != null && centro.LatitudNumeric != 0 && centro.LongitudNumeric != 0)
        {
            await Task.Delay(1000);
            await InicializarMapa();
        }
    }

    private async Task CargarDatos()
    {
        cargando = true;

        if (!string.IsNullOrEmpty(Codigo))
        {
            centro = await CentrosService.ObtenerCentroPorCodigoAsync(Codigo);

            if (centro != null)
            {
                cargandoClima = true;
                StateHasChanged();

                try
                {
                    var (current, forecast) = await WeatherService.ObtenerClimaAsync(
                        centro.DMUNIC,
                        centro.TerritorioNormalizado
                    );

                    weatherCurrent = current;
                    previsiones = forecast;
                }
                catch
                {
                    weatherCurrent = null;
                    previsiones = new List<WeatherDay>();
                }
                finally
                {
                    cargandoClima = false;
                }
            }
        }

        cargando = false;
    }

    private async Task InicializarMapa()
    {
        if (centro == null || centro.LatitudNumeric == 0 || centro.LongitudNumeric == 0)
        {
            errorMapa = "Coordenadas invalidas";
            return;
        }

        try
        {
            var mapStyle = $"mapbox://styles/mapbox/{tipoMapa}";

            await JSRuntime.InvokeVoidAsync("initializeMap",
                token,
                centro.LatitudNumeric,
                centro.LongitudNumeric,
                zoom,
                centro.NOMBRE,
                mapStyle);

            mapaInicializado = true;
            errorMapa = string.Empty;
        }
        catch (Exception ex)
        {
            errorMapa = $"Error al inicializar mapa: {ex.Message}";
        }
    }

    private async Task CambiarTipoMapa(string nuevoTipo)
    {
        tipoMapa = nuevoTipo;
        mapaInicializado = false;
        await Task.Delay(300);
        await InicializarMapa();
    }

    private void Volver()
    {
        Navigation.NavigateTo("/");
    }
}