@page "/"
@using Reto2FINAL.Models
@using Reto2FINAL.Services
@inject CentrosService CentrosService
@inject NavigationManager Navigation

<div class="container-fluid p-4">
    <!-- Cabecera -->
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1>
                <span class="text-primary"></span> Centros Educativos de Euskadi
            </h1>
            <p class="text-muted">Framework Educativo - CIFP Elorrieta-Errekamari LHII</p>
        </div>
    </div>

    <!-- Filtros: DTITUC → DTERRE → DMUNIC -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label fw-bold">Tipo de Centro (DTITUC)</label>
            <select class="form-select" @onchange="OnTipoCentroChanged" value="@tipoCentroSeleccionado">
                <option value="">-- Todos --</option>
                @foreach (var tipo in tiposCentro)
                {
                    <option value="@tipo">@tipo</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label fw-bold">Territorio (DTERRE)</label>
            <select class="form-select" @onchange="OnTerritorioChanged" value="@territorioSeleccionado" disabled="@string.IsNullOrEmpty(tipoCentroSeleccionado)">
                <option value="">-- Todos --</option>
                @foreach (var territorio in territorios)
                {
                    <option value="@territorio">@territorio</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label fw-bold">Municipio (DMUNIC)</label>
            <select class="form-select" @onchange="OnMunicipioChanged" value="@municipioSeleccionado" disabled="@string.IsNullOrEmpty(territorioSeleccionado)">
                <option value="">-- Todos --</option>
                @foreach (var municipio in municipios)
                {
                    <option value="@municipio">@municipio</option>
                }
            </select>
        </div>
    </div>

    <!-- Contador de centros filtrados -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="alert alert-info">
                <strong>Centros filtrados:</strong> @centrosFiltrados.Count
            </div>
        </div>
    </div>

    <!-- Tabla de centros -->
    @if (cargando)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-primary">
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Municipio</th>
                                <th>Territorio</th>
                                <th>Tipo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var centro in GetPaginatedCentros())
                            {
                                <tr>
                                    <td>@centro.CODIGO</td>
                                    <td>@centro.NOMBRE</td>
                                    <td>@centro.DMUNIC</td>
                                    <td>@centro.DTERRE</td>
                                    <td>@centro.DTITUC</td>
                                    <td>
                                        <!-- Enlace a detalles -->
                                        <button class="btn btn-sm btn-primary" @onclick="() => VerDetalle(centro.CODIGO)">
                                            Ver Detalle
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                            <a class="page-link" @onclick="() => CambiarPagina(paginaActual - 1)">Anterior</a>
                        </li>
                        @for (int i = 1; i <= totalPaginas; i++)
                        {
                            var pagina = i;
                            <li class="page-item @(paginaActual == pagina ? "active" : "")">
                                <a class="page-link" @onclick="() => CambiarPagina(pagina)">@pagina</a>
                            </li>
                        }
                        <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                            <a class="page-link" @onclick="() => CambiarPagina(paginaActual + 1)">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

@code {
    private List<string> tiposCentro = new();
    private List<string> territorios = new();
    private List<string> municipios = new();

    private string? tipoCentroSeleccionado;
    private string? territorioSeleccionado;
    private string? municipioSeleccionado;

    private List<Centro> centrosFiltrados = new();
    private bool cargando = true;

    // Paginación
    private int paginaActual = 1;
    private int elementosPorPagina = 10;
    private int totalPaginas => (int)Math.Ceiling((double)centrosFiltrados.Count / elementosPorPagina);

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        tiposCentro = await CentrosService.ObtenerTiposCentroAsync();
        centrosFiltrados = await CentrosService.ObtenerTodosCentrosAsync();
        cargando = false;
    }

    private async Task OnTipoCentroChanged(ChangeEventArgs e)
    {
        tipoCentroSeleccionado = e.Value?.ToString();
        territorioSeleccionado = null;
        municipioSeleccionado = null;

        territorios = await CentrosService.ObtenerTerritoriosPorTipoAsync(tipoCentroSeleccionado);
        municipios = new();

        await FiltrarCentros();
    }

    private async Task OnTerritorioChanged(ChangeEventArgs e)
    {
        territorioSeleccionado = e.Value?.ToString();
        municipioSeleccionado = null;

        municipios = await CentrosService.ObtenerMunicipiosPorTerritorioAsync(tipoCentroSeleccionado, territorioSeleccionado);

        await FiltrarCentros();
    }

    private async Task OnMunicipioChanged(ChangeEventArgs e)
    {
        municipioSeleccionado = e.Value?.ToString();
        await FiltrarCentros();
    }

    private async Task FiltrarCentros()
    {
        centrosFiltrados = await CentrosService.FiltrarCentrosAsync(
            tipoCentroSeleccionado,
            territorioSeleccionado,
            municipioSeleccionado
        );
        paginaActual = 1;
    }

    private List<Centro> GetPaginatedCentros()
    {
        return centrosFiltrados
            .Skip((paginaActual - 1) * elementosPorPagina)
            .Take(elementosPorPagina)
            .ToList();
    }

    private void CambiarPagina(int pagina)
    {
        if (pagina >= 1 && pagina <= totalPaginas)
        {
            paginaActual = pagina;
        }
    }

    private void VerDetalle(string codigo)
    {
        Navigation.NavigateTo($"/detalle/{codigo}");
    }
}